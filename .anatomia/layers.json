{
  "$comment": "Anatomia のプログラムドメイン (二層判定) 用の層宣言。 glob は repo 相対パスへ完全一致 (`*` = 1 階層)。 ローダーが glob 文字列でソートして先勝ちで評価するため、 glob を重ねずモジュール 1 つにつき `<dir>/*` を 1 本置く。 確認は `anatomia domains program --repo .` で unclassified 0。",
  "layers": [
    {
      "glob": "libraries/browser-overlay/*",
      "layer": "presentation"
    },
    {
      "glob": "libraries/native-overlay/host/*",
      "layer": "infrastructure"
    },
    {
      "glob": "Packages/jp.ludiars.praeforma.tela/Editor/*",
      "layer": "presentation"
    },
    {
      "glob": "Packages/jp.ludiars.praeforma.tela/Editor/Native/*",
      "layer": "infrastructure"
    },
    {
      "glob": "Packages/jp.ludiars.praeforma/Editor/*",
      "layer": "presentation"
    },
    {
      "glob": "Packages/jp.ludiars.praeforma/Editor/Api/*",
      "layer": "infrastructure"
    },
    {
      "glob": "Packages/jp.ludiars.praeforma/Editor/Instructions/*",
      "layer": "application"
    },
    {
      "glob": "Packages/jp.ludiars.praeforma/Editor/Views/*",
      "layer": "presentation"
    },
    {
      "glob": "Packages/jp.ludiars.praeforma/Runtime/*",
      "layer": "domain-logic"
    },
    {
      "glob": "Packages/jp.ludiars.praeforma/Tests/Editor/*",
      "layer": "shared"
    },
    {
      "glob": "server/*",
      "layer": "infrastructure"
    },
    {
      "glob": "server/contracts/*",
      "layer": "shared"
    },
    {
      "glob": "server/scripts/*",
